#!/bin/bash

# Trigger the KWin picker, convert the raw uint32 color to HEX, and copy to clipboard
dbus-send --print-reply --dest=org.kde.KWin /ColorPicker org.kde.kwin.ColorPicker.pick | awk '/uint32/ {printf "#%06x\n", $2 % 16777216}' | wl-copy

# Send a desktop notification so you know it worked!
notify-send "Color Picked" "Hex code copied to clipboard!" --icon=color-picker
